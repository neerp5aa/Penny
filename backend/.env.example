# development | test | production. The demo token below is refused outside development.
PENNY_ENVIRONMENT=development
PENNY_FRONTEND_ORIGIN=http://localhost:3000
# Project URL only (no /rest/v1). Access tokens are verified with this project's public JWKS.
PENNY_SUPABASE_URL=https://your-project-ref.supabase.co
# Leave empty for asymmetric (ECC P-256) signing keys. Only for legacy HS256 projects.
PENNY_SUPABASE_JWT_SECRET=
# Optional, development only: fictional bearer token for the offline demo.
PENNY_DEMO_AUTH_TOKEN=
# Optional: Supabase user id (UUID) allowed to use the fictional Maya data set until PEN-002.
PENNY_DEMO_OWNER_USER_ID=
# Optional. Without a key, Penny AI answers with built-in summaries of the same verified data.
PENNY_OPENAI_API_KEY=
PENNY_OPENAI_MODEL=gpt-6.1-sol
PENNY_COACH_TIMEOUT_SECONDS=45
